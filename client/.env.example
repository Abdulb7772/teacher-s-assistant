# Next.js public environment variables
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:5000
# Must match the backend's JWT_SECRET — used by edge middleware to verify the
# HttpOnly `token` cookie on every protected route.
JWT_SECRET=<generate with: openssl rand -base64 32>

# Cloudinary unsigned browser upload configuration.
# Only the cloud name and unsigned upload preset are safe to expose to the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<your-cloud-name>
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<your-unsigned-upload-preset>
