# Next.js public environment variables
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://localhost:5000
# Must match the backend's JWT_SECRET — used by edge middleware to verify the
# HttpOnly `token` cookie on every protected route.
JWT_SECRET=<generate with: openssl rand -base64 32>

# PDFs are uploaded through the backend; Cloudinary credentials belong in
# server/.env (or the Render service environment), not in the client.
