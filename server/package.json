{
  "name": "teacher-assistant-server",
  "version": "1.0.0",
  "description": "Teacher Assistant - Course Management Portal backend API (TypeScript)",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
